{
  "expo": {
    "name": "daily-app",
    "slug": "daily-app",
    "scheme": "dailyapp",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFCF1",
          "image": "./assets/img/splash-icon.png",
          "dark": {
            "image": "./assets/img/splash-icon-dark.png",
            "backgroundColor": "#2b2b2b"
          },
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "react-native-enriched-markdown"
    ],
    "orientation": "portrait",
    "icon": "./assets/img/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.dailyapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.dailyapp"
    },
    "web": {
      "favicon": "./assets/img/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c35d661d-8639-4859-9eb7-51c7929fee59"
      }
    }
  }
}
