{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@navigation/*": [
        "./src/navigation/*"
      ],
      "@themes/*": [
        "./src/themes/*"
      ],
      "@assets/*": [
        "./assets/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ]
    }
  }
}